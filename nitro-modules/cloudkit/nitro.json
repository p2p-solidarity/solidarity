{
  "$schema": "https://nitro.margelo.com/schemas/nitro.schema.json",
  "cxxNamespace": ["solidarity", "cloudkit"],
  "ios": {
    "iosModuleName": "SolidarityCloudKit"
  },
  "android": {
    "androidNamespace": ["gg", "solidarity", "cloudkit"],
    "androidCxxLibName": "SolidarityCloudKit"
  },
  "autolinking": {
    "CloudKit": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCloudKit"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCloudKit"
      }
    }
  }
}
