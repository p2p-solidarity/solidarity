crash.*.log

# EAS local build artifacts
apps/expo/build-*.aab
apps/expo/*.aab
# Local versionCode cache (populated by `eas build:version:get`)
apps/expo/.android-version-code

# CNG-generated native dirs (regenerated by `expo prebuild`)
# Keep only the tiny Xcode Cloud bootstrap anchor checked in so workflow setup
# can discover the Expo workspace/scheme before ci_post_clone regenerates ios/.
apps/expo/ios/*
!apps/expo/ios/ci_scripts/
!apps/expo/ios/ci_scripts/ci_post_clone.sh
!apps/expo/ios/Solidarity.xcworkspace/
apps/expo/ios/Solidarity.xcworkspace/*
!apps/expo/ios/Solidarity.xcworkspace/contents.xcworkspacedata
!apps/expo/ios/Solidarity.xcodeproj/
apps/expo/ios/Solidarity.xcodeproj/*
!apps/expo/ios/Solidarity.xcodeproj/project.pbxproj
!apps/expo/ios/Solidarity.xcodeproj/xcshareddata/
apps/expo/ios/Solidarity.xcodeproj/xcshareddata/*
!apps/expo/ios/Solidarity.xcodeproj/xcshareddata/xcschemes/
apps/expo/ios/Solidarity.xcodeproj/xcshareddata/xcschemes/*
!apps/expo/ios/Solidarity.xcodeproj/xcshareddata/xcschemes/Solidarity.xcscheme
apps/expo/android/
# Root-level ios/ + android/ + app.json — only ever happen if someone runs
# `expo prebuild` from the workspace root by mistake; the legitimate
# native dirs live under apps/expo/{ios,android}/.
/ios/
/android/
/app.json

# Nitro nitrogen-generated boilerplate — these are real build artifacts
# used by CocoaPods + Gradle, so they must be committed. Only ignore
# the cache dir if nitrogen ever creates one.
# nitro-modules/**/nitrogen/generated/  (committed)

# Tests / coverage
coverage/
__snapshots__/

# Re-include monorepo packages/ — Swift template's `Packages` rule (line ~89)
# matches case-insensitively on macOS HFS+ and otherwise hides our packages/ dir.
!/packages/
!/packages/**
# …but workspace node_modules (and bun's symlink hoisting) must stay ignored.
packages/*/node_modules/
apps/*/node_modules/
nitro-modules/*/node_modules/
# Re-exclude tsc incremental build cache (the broad re-include above swallows
# the global `*.tsbuildinfo` rule for anything under packages/).
packages/**/*.tsbuildinfo

# Android C++ build artifacts (.cxx is regenerated on every assemble*).
nitro-modules/*/android/.cxx/
nitro-modules/*/android/build/
nitro-modules/*/android/.gradle/

# Rust xcframework outputs produced by nitro-modules/*/rust/build-ios.sh.
# These are ~130 MB per build and must be rebuilt locally — never commit.
nitro-modules/**/*.xcframework/

# Android cdylibs built by nitro-modules/passport-zk/scripts/build-android.sh
# from ../passport-noir/mopro-binding. ~30 MB per ABI — rebuild locally.
nitro-modules/passport-zk/android/src/main/jniLibs/*/libpassport_zk_mopro.so
nitro-modules/passport-zk/android/src/main/jniLibs/*/libc++_shared.so

# Other circuit/SRS pairs that build-android.sh might drop into assets/
# while we iterate on which v3 circuit to default to. Only the current
# default (disclosure.{json,srs.bin}) is checked in.
nitro-modules/passport-zk/android/src/main/assets/passport_verifier.*
nitro-modules/passport-zk/android/src/main/assets/passport_adapter.*
nitro-modules/passport-zk/android/src/main/assets/composite_show.*
nitro-modules/passport-zk/android/src/main/assets/openac_show.*
