# === Monorepo / Expo / RN (added 2026-05-24 for Expo migration) ===
node_modules/
.bun/
.cache/
.turbo/
dist/
build/
*.tsbuildinfo
.eslintcache

# Expo
.expo/
.expo-shared/
expo-env.d.ts
web-build/

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# CNG-generated native dirs (regenerated by `expo prebuild`)
# Note: re-including a subdirectory only works when the parent itself isn't
# excluded. So we ignore *contents* of ios/ (with /*) and re-allow ci_scripts/.
apps/expo/ios/*
!apps/expo/ios/ci_scripts/
apps/expo/android/
# Root-level ios/ + app.json — only ever happen if someone runs
# `expo prebuild` from the workspace root by mistake; the legitimate
# native dir lives under apps/expo/ios/.
/ios/
/app.json

# Nitro nitrogen-generated boilerplate — these are real build artifacts
# used by CocoaPods + Gradle, so they must be committed. Only ignore
# the cache dir if nitrogen ever creates one.
# nitro-modules/**/nitrogen/generated/  (committed)

# Tests / coverage
coverage/
__snapshots__/

# Re-include monorepo packages/ — Swift template's `Packages` rule (line ~89)
# matches case-insensitively on macOS HFS+ and otherwise hides our packages/ dir.
!/packages/
!/packages/**
# …but workspace node_modules (and bun's symlink hoisting) must stay ignored.
packages/*/node_modules/
apps/*/node_modules/
nitro-modules/*/node_modules/

# Android C++ build artifacts (.cxx is regenerated on every assemble*).
nitro-modules/*/android/.cxx/
nitro-modules/*/android/build/
nitro-modules/*/android/.gradle/

# Rust xcframework outputs produced by nitro-modules/*/rust/build-ios.sh.
# These are ~130 MB per build and must be rebuilt locally — never commit.
nitro-modules/**/*.xcframework/
