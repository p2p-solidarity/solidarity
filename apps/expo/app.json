{
  "expo": {
    "name": "Solidarity",
    "slug": "airmeishi",
    "scheme": ["solidarity", "airmeishi", "openid-credential-offer"],
    "version": "1.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "kidneyweakx.airmeishi",
      "supportsTablet": true,
      "associatedDomains": ["applinks:solidarity.gg"],
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.$(CFBundleIdentifier)"
        ],
        "com.apple.developer.icloud-services": ["CloudDocuments", "CloudKit"],
        "com.apple.developer.nfc.readersession.formats": ["TAG"],
        "com.apple.developer.pass-type-identifiers": [
          "$(TeamIdentifierPrefix)pass.kidneyweakx.airmeishi"
        ],
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Solidarity uses the camera to scan QR codes and business cards.",
        "NSContactsUsageDescription": "Solidarity can save business card information to your Contacts.",
        "NSLocalNetworkUsageDescription": "Solidarity discovers nearby devices for proximity sharing.",
        "NSNearbyInteractionUsageDescription": "Solidarity uses Nearby Interaction to measure distance and direction of nearby devices.",
        "NFCReaderUsageDescription": "Solidarity reads your passport's NFC chip to verify identity.",
        "NSFaceIDUsageDescription": "Solidarity uses Face ID to protect identity keys and authorize sensitive actions.",
        "NSPhotoLibraryUsageDescription": "Solidarity saves QR codes and business card images to your Photo Library.",
        "NSBonjourServices": ["_say-share._tcp.", "_airmeishi-share._tcp."],
        "UIBackgroundModes": ["remote-notification", "fetch"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kidneyweakx.airmeishi",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.NFC",
        "android.permission.UWB_RANGING",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "solidarity.gg" }],
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://solidarity.gg"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Solidarity uses the camera to scan QR codes and passport MRZ.",
          "enableCodeScanner": true,
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "./plugins/withXcodeCloudScripts.js"
    ],
    "runtimeVersion": "1.3.1",
    "updates": {
      "url": "https://u.expo.dev/REPLACE-WITH-EAS-PROJECT-ID",
      "enabled": true
    }
  }
}
