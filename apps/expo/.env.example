# Solidarity Expo runtime env — copy to .env.local for local dev.
# All keys MUST be prefixed EXPO_PUBLIC_ to be exposed to the JS bundle.

# Sakura messaging relay (port from Swift MessageService backend URL)
EXPO_PUBLIC_SAKURA_API_URL=https://api.solidarity.gg

# Google Sign-In (for Android Drive sync)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# EAS Update channel
EXPO_PUBLIC_UPDATE_CHANNEL=production
