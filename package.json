{
  "name": "solidarity-monorepo",
  "version": "1.3.1",
  "private": true,
  "description": "Solidarity (AirMeishi) — SwiftUI legacy + Expo/RN target + Nitro modules. See docs/migration/00-MIGRATION_PLAN.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "nitro-modules/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "cd apps/expo && bun run typecheck",
    "test": "bun test",
    "test:unit": "SKIP_INTEGRATION=1 bun test __tests__/unit",
    "test:parity": "bun test __tests__/parity",
    "expo:ios": "cd apps/expo && bun run ios",
    "expo:android": "cd apps/expo && bun run android",
    "expo:start": "cd apps/expo && bun run start",
    "expo:prebuild:ios": "cd apps/expo && bunx expo prebuild --platform ios",
    "expo:prebuild:android": "cd apps/expo && bunx expo prebuild --platform android",
    "build:ios:local": "cd apps/expo && bun run build:ios:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "expo": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
