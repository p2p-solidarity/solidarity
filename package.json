{
  "name": "solidarity-monorepo",
  "version": "1.3.1",
  "private": true,
  "description": "Solidarity (AirMeishi) — SwiftUI legacy + Expo/RN target + Nitro modules. See docs/migration/00-MIGRATION_PLAN.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "nitro-modules/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc -b",
    "test": "bun test",
    "test:unit": "SKIP_INTEGRATION=1 bun test __tests__/unit",
    "test:parity": "bun test __tests__/parity",
    "expo:ios": "cd apps/expo && bun run ios",
    "expo:android": "cd apps/expo && bun run android",
    "expo:start": "cd apps/expo && bun run start",
    "expo:prebuild:ios": "cd apps/expo && bunx expo prebuild --platform ios",
    "expo:prebuild:android": "cd apps/expo && bunx expo prebuild --platform android"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "bun@1.2.0",
  "engines": {
    "node": ">=20"
  }
}
